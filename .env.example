# Firebase Admin SDK Service Account (download from Firebase Console)
# Path: Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Firebase Storage Bucket
# Format: your-project.appspot.com
STORAGE_BUCKET=your-project.appspot.com

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Optional: Custom region (default: asia-south1)
FIREBASE_REGION=asia-south1
